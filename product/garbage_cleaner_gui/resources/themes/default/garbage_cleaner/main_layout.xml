<?xml version="1.0" encoding="UTF-8"?>
<!--
  主窗口布局。
  说明：
    * 根节点固定为 Window，caption 指定可拖动区域（自绘标题栏）。
    * closebtn / minbtn 这两个名字由 WindowImplBase 自动接线，不能改名。
    * 其余控件在 GcMainForm::InitWindow 里按 name 查找并绑定事件。
-->
<Window size="920,620" caption="0,0,0,35" mininfo="720,420">
    <VBox bkcolor="bk_wnd_darkcolor">

        <!-- 自绘标题栏 -->
        <HBox width="stretch" height="35" bkcolor="bk_wnd_lightcolor">
            <Label name="title_label" text="垃圾清理工具" margin="12,0,0,0" font="system_bold_14"
                   normaltextcolor="darkcolor" valign="center"/>
            <Control />
            <Button class="btn_wnd_min" name="minbtn" margin="4,6,0,0"/>
            <Button class="btn_wnd_close" name="closebtn" margin="4,6,8,0"/>
        </HBox>

        <!-- 目录选择行 -->
        <HBox width="stretch" height="48" padding="12,8,12,0">
            <Label text="扫描目录：" font="system_14" normaltextcolor="darkcolor" valign="center"/>
            <Label name="root_label" width="stretch" font="system_14" normaltextcolor="darkcolor"
                   valign="center" endellipsis="true" margin="0,0,8,0"/>
            <Button class="btn_global_white_80x30" name="choose_btn" text="选择目录" margin="0,4,8,4"/>
            <Button class="btn_global_blue_80x30" name="scan_btn" text="开始扫描" margin="0,4,0,4"/>
        </HBox>

        <!-- 结果标题行 -->
        <HBox width="stretch" height="30" padding="14,6,14,0">
            <Label text="路径" width="stretch" font="system_bold_12" normaltextcolor="lightcolor"/>
            <Label text="类别" width="90" font="system_bold_12" normaltextcolor="lightcolor" align="right"/>
            <Label text="大小" width="90" font="system_bold_12" normaltextcolor="lightcolor" align="right"/>
        </HBox>

        <!-- 结果列表：
             必须用 VListBox 而不是 ListBox —— 框架里 ListBox 绑的是基类 Layout，
             它只给 float 子控件定位，普通子项永远拿不到位置/尺寸（现象是行不显示）；
             VListBox 绑的是 VLayout，才会逐行纵向排列并撑满宽度。 -->
        <VListBox name="file_list" class="list" width="stretch" height="stretch" margin="12,4,12,4"/>

        <!-- 底部：汇总 + 清理 -->
        <HBox width="stretch" height="56" padding="12,4,12,8">
            <VBox width="stretch">
                <Label name="summary_label" text="尚未扫描。" font="system_12" normaltextcolor="dark_gray"
                       endellipsis="true"/>
                <Label name="status_label" text="就绪。" font="system_12" normaltextcolor="blue"
                       endellipsis="true" margin="0,4,0,0"/>
            </VBox>
            <Button class="btn_global_red_80x30" name="clean_btn" text="清理" margin="8,8,0,8"/>
        </HBox>

    </VBox>
</Window>
